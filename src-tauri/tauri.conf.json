{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alpha and Omega",
  "mainBinaryName": "AlphaOmega",
  "version": "../package.json",
  "identifier": "io.github.fisbal.alphaomega",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alpha & Omega",
        "zoomHotkeysEnabled": true,
        "width": 1280,
        "height": 860,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#14151D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "Martin Balla",
    "shortDescription": "Alpha & Omega",
    "longDescription": "Alpha & Omega by Martin B: a bilingual New Testament study app with verse-by-verse commentary. Works offline.",
    "category": "Education",
    "copyright": "Martin Balla",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_BY_CI_FROM_THE_TAURI_SIGNING_PUBLIC_KEY_SECRET",
      "endpoints": ["https://github.com/fisbal/alpha-omega/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
